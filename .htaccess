# Security headers
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Let SSL verification work
    RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
    RewriteRule ^ - [L]

    # Block access to protected directories
    RewriteRule ^app/ - [F,L]
    RewriteRule ^cron/ - [F,L]
    RewriteRule ^logs/ - [F,L]
    RewriteRule ^sql/ - [F,L]
    RewriteRule ^templates/ - [F,L]

    # Disable directory listings
    Options -Indexes

    # Route root to public/index.php
    RewriteRule ^$ public/index.php [L]

    # Route a request through public/, but only when the target actually exists
    # there. The existence test is load-bearing: the previous version rewrote
    # unconditionally, so a path that did not exist became public/<path>, failed
    # the !-f test again, became public/public/<path>, and kept going until
    # Apache hit its internal redirect limit and returned 500. Search engines
    # read 500 as "broken, retry later" rather than "gone", so dead URLs never
    # dropped out of the index.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    # Anything still unresolved is genuinely unknown. Serve the 404 page
    # directly instead of via ErrorDocument, which fails on this host: the
    # subrequest itself errors and Apache returns 500 with "a 500 Internal
    # Server Error was encountered while trying to use an ErrorDocument".
    # public/404.php sends the 404 status itself. No loop is possible because
    # that file exists, so the !-f condition stops matching on the next pass.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /public/404.php [L]
</IfModule>

# Deny access to sensitive files
<FilesMatch "\.(env|sql|log|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
